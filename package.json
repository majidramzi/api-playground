{
  "name": "api-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A lightweight, browser-based REST API testing client that works entirely client-side. No backend, no login, no cloud storage.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "api",
    "rest",
    "http",
    "client",
    "testing",
    "playground",
    "postman-alternative"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majidramzi/api-playground.git"
  },
  "homepage": "https://majidramzi.github.io/api-playground/",
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
